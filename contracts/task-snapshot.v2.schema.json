{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sixu:task-snapshot:v2",
  "title": "司序·知所先后：任务快照v2",
  "description": "本地确认与重算接口的结构契约；跨字段语义由snapshot.py另行校验，结构通过不等于可行排程。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "timezone", "reference_time", "sources", "tasks", "availability"],
  "properties": {
    "schema_version": {"const": 2},
    "revision": {"type": "integer", "minimum": 0},
    "label": {"type": "string", "maxLength": 200},
    "timezone": {"const": "Asia/Shanghai"},
    "reference_time": {"$ref": "#/$defs/timestamp"},
    "sources": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/source"}},
    "tasks": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/task"}},
    "availability": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/interval"}},
    "availability_confirmed": {"type": "boolean", "description": "true表示用户已明确确认可用时段，空数组才代表0空闲；false表示尚未确认。兼容旧快照：省略时仅非空数组视为已提供时段。"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 100},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "nullableTimestamp": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
    "interval": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {"start": {"$ref": "#/$defs/timestamp"}, "end": {"$ref": "#/$defs/timestamp"}}
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "text", "published_at"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["pasted_notice", "manual", "synthetic"]},
        "text": {"type": "string", "minLength": 1, "maxLength": 100000},
        "published_at": {"$ref": "#/$defs/nullableTimestamp"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "origin", "source_id", "quote"],
      "properties": {
        "field": {"enum": ["title", "kind", "earliest_start_at", "deadline_at", "fixed_start_at", "fixed_end_at", "visit_windows", "remaining_minutes", "location", "materials", "must_do", "priority", "depends_on"]},
        "origin": {"enum": ["source_text", "user_input", "inferred"]},
        "source_id": {"type": ["string", "null"]},
        "quote": {"type": ["string", "null"], "maxLength": 3000}
      },
      "allOf": [{"if": {"properties": {"origin": {"const": "source_text"}}}, "then": {"properties": {"source_id": {"$ref": "#/$defs/id"}, "quote": {"type": "string", "minLength": 1}}}}]
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_id", "title", "kind", "status", "earliest_start_at", "deadline_at", "fixed_start_at", "fixed_end_at", "visit_windows", "remaining_minutes", "splittable", "min_block_minutes", "must_do", "priority", "location", "materials", "depends_on", "confirmed_fields", "evidence", "uncertainties"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "source_id": {"type": ["string", "null"]},
        "title": {"type": "string", "maxLength": 200},
        "kind": {"enum": ["flexible", "fixed", "visit_window", "milestone"]},
        "status": {"enum": ["draft", "confirmed", "scheduled", "in_progress", "completed", "cancelled"]},
        "earliest_start_at": {"$ref": "#/$defs/nullableTimestamp"},
        "deadline_at": {"$ref": "#/$defs/nullableTimestamp"},
        "fixed_start_at": {"$ref": "#/$defs/nullableTimestamp"},
        "fixed_end_at": {"$ref": "#/$defs/nullableTimestamp"},
        "visit_windows": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/interval"}},
        "remaining_minutes": {"type": ["integer", "null"], "minimum": 0},
        "splittable": {"type": ["boolean", "null"]},
        "min_block_minutes": {"type": ["integer", "null"], "minimum": 1},
        "must_do": {"type": ["boolean", "null"]},
        "priority": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "location": {"type": ["string", "null"], "maxLength": 500},
        "materials": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "depends_on": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "confirmed_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "uncertainties": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "allOf": [
        {"if": {"properties": {"status": {"not": {"const": "draft"}}}}, "then": {"properties": {"title": {"minLength": 1}}}},
        {"if": {"properties": {"status": {"const": "completed"}}}, "then": {"properties": {"remaining_minutes": {"const": 0}}}},
        {"if": {"properties": {"kind": {"const": "fixed"}, "status": {"enum": ["confirmed", "scheduled", "in_progress"]}}}, "then": {"properties": {"fixed_start_at": {"$ref": "#/$defs/timestamp"}, "fixed_end_at": {"$ref": "#/$defs/timestamp"}, "remaining_minutes": {"const": 0}}}},
        {"if": {"properties": {"kind": {"const": "visit_window"}, "status": {"enum": ["confirmed", "scheduled", "in_progress"]}}}, "then": {"properties": {"visit_windows": {"minItems": 1}}}},
        {"if": {"properties": {"kind": {"const": "milestone"}}}, "then": {"properties": {"remaining_minutes": {"const": 0}}}}
      ]
    }
  }
}
