# 仅复制本示例中的配置名，在服务端环境填写；不要把真实密钥写入前端、Git或聊天。
# 默认关闭模型调用。新Workflow须先导入、选定模型并发布，然后填写它的应用API key。
SIXU_MODEL_EXTRACTION_ENABLED=false
DIFY_API_BASE=https://api.dify.ai/v1
DIFY_API_KEY=
# socket连接/读取等待超时（5..90秒）；不是服务端绝对执行时长，也不保证Dify取消运行。
DIFY_TIMEOUT_SECONDS=60

# 本轮 /api/v2/extract 仅允许实际loopback客户端；不要信任X-Forwarded-For。
# 有Origin的请求还需匹配下列精确站点。无Origin请求仍必须来自本机。
SIXU_MODEL_ALLOWED_ORIGINS=http://127.0.0.1:8873,http://localhost:8873
# 程序固定每进程并发1、每分钟6次、每小时60次，失败尝试也计数。
# 重启会重置预算，多个进程不共享预算，因此这些限制不提供账单金额保证。
# 公网发布前必须配置登录/鉴权网关和提供商账户限额；不能仅把CORS改成*就开放付费API。
# 请使用HTTPS上游；HTTP只适合本机假上游测试或可信隔离部署，避免明文传输key。
# 本程序不自动读取.env；请用系统或部署平台的环境变量机制安全加载配置。

# DeepSeek（课表文字/截图识别、“结合原文问问模型”估计结束时间）。
DEEPSEEK_API_KEY=

# ---- 线上开放模型功能（1.20）----
# 不填口令时，模型功能只对本机工作台开放（上面的规则）。填写至少6位的口令后，
# 来自 SIXU_PUBLIC_ORIGINS 页面、并在 X-Sixu-Access 里带对口令的请求才可调用模型。
# 口令错10次锁定该IP一小时；成功调用按北京时间每天计数，全站与单个IP各有上限。
# Origin 可以伪造，真正的保护是口令和每日上限；提供商账户仍应设置余额或用量提醒。
# 进程重启会清零计数；多个进程不共享计数。
SIXU_MODEL_ACCESS_CODE=
SIXU_PUBLIC_ORIGINS=https://sageramo.github.io
SIXU_MODEL_DAILY_LIMIT=200
SIXU_MODEL_IP_DAILY_LIMIT=30
