[
  {
    "id": "N01",
    "title": "下午3点应规范为15点",
    "adapter": "notice",
    "input": {
      "text": "请于2026年10月25日下午3点前报名。"
    },
    "checks": [
      {
        "field": "time_values",
        "op": "contains",
        "value": "2026-10-25 15:00"
      }
    ]
  },
  {
    "id": "N02",
    "title": "活动区间保留20点结束",
    "adapter": "notice",
    "input": {
      "text": "比赛时间为2026年10月26日18:00-20:00。"
    },
    "checks": [
      {
        "field": "time_values",
        "op": "contains_fragment",
        "value": "20:00"
      }
    ]
  },
  {
    "id": "N03",
    "title": "活动时间不被前句报名污染",
    "adapter": "notice",
    "input": {
      "text": "讲座报名通知\n请于2026年10月25日下午3点前报名，讲座于2026年10月26日18:00-20:00在教学楼101举行。"
    },
    "checks": [
      {
        "field": "time_types",
        "op": "contains",
        "value": {
          "value": "2026-10-26 18:00",
          "type": "活动/比赛时间"
        }
      }
    ]
  },
  {
    "id": "N04",
    "title": "相对日期使用明确参照",
    "adapter": "notice",
    "input": {
      "text": "明天下午3点截止报名。",
      "reference_date": "2026-10-24",
      "timezone": "Asia/Shanghai"
    },
